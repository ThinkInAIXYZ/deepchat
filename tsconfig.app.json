{
  "extends": "@electron-toolkit/tsconfig/tsconfig.web.json",
  "include": [
    "src/renderer/src/env.d.ts",
    "src/renderer/src/**/*",
    "src/renderer/src/**/*.vue",
    "src/renderer/src/assets/**/*",
    "src/renderer/browser-overlay/env.d.ts",
    "src/renderer/browser-overlay/**/*",
    "src/renderer/browser-overlay/**/*.vue",
    "src/renderer/floating/env.d.ts",
    "src/renderer/floating/**/*",
    "src/renderer/floating/**/*.vue",
    "src/renderer/floating/assets/**/*",
    "src/renderer/splash/**/*",
    "src/renderer/splash/**/*.vue",
    "src/renderer/splash/assets/**/*",
    "src/preload/*.d.ts",
    "src/renderer/api/**/*",
    "src/renderer/services/**/*",
    "src/shared/**/*",
    "src/shadcn/**/*",
    "src/dc-ui/**/*",
    "src/dc-ui/**/*.vue",
    "src/renderer/settings/**/*",
    "src/renderer/settings/**/*.vue"
  ],
  "compilerOptions": {
    "module": "esnext",
    "moduleResolution": "bundler",
    "composite": false,
    "declaration": false,
    "emitDeclarationOnly": false,
    "noEmit": true,
    "paths": {
      "@/*": [
        "./src/renderer/src/*"
      ],
      "@api/*": [
        "./src/renderer/api/*"
      ],
      "@renderer-notifications": [
        "./src/renderer/services/notifications/index.ts"
      ],
      "@renderer-notifications/*": [
        "./src/renderer/services/notifications/*"
      ],
      "@shared/*": [
        "./src/shared/*"
      ],
      "@shadcn/*": [
        "./src/shadcn/*"
      ],
      "@dc-ui/*": [
        "./src/dc-ui/*"
      ]
    }
  }
}
