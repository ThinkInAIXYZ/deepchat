{
  "ignorePatterns": [
    "**/node_modules",
    "**/dist",
    "**/out",
    ".gitignore",
    ".github",
    ".cursor",
    ".vscode",
    "packages/desktop/build/**",
    "packages/desktop/resources/**",
    "scripts/**",
    "packages/desktop/runtime/**",
    "docs/**",
    "packages/desktop/test/**",
    "packages/desktop/src/shared/**/*",
    "!packages/desktop/src/shared/contracts/events/mcp.events.ts",
    "!packages/desktop/src/shared/contracts/routes/mcp.routes.ts",
    "!packages/desktop/src/shared/types/core/mcp.ts",
    "!packages/desktop/src/shared/types/mcp.ts",
    "packages/desktop/src/shadcn/**"
  ],
  "overrides": [
    {
      "files": ["packages/desktop/src/main/**/*.ts"],
      "rules": {
        "no-console": ["error", { "allow": ["warn", "error", "info", "debug", "trace"] }]
      }
    },
    {
      "files": [
        "packages/desktop/src/main/mcp/**/*.ts",
        "packages/desktop/src/shared/contracts/events/mcp.events.ts",
        "packages/desktop/src/shared/contracts/routes/mcp.routes.ts",
        "packages/desktop/src/shared/types/core/mcp.ts",
        "packages/desktop/src/shared/types/mcp.ts"
      ],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "paths": [
              {
                "name": "@modelcontextprotocol/sdk",
                "message": "MCP v2 code must use the split packages."
              }
            ],
            "patterns": [
              {
                "group": ["@modelcontextprotocol/sdk/*"],
                "message": "MCP v2 code must use the split packages."
              }
            ]
          }
        ]
      }
    }
  ]
}
