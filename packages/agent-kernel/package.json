{
  "name": "@deepchat/agent-kernel",
  "version": "0.0.0",
  "private": true,
  "description": "Portable built-in DeepChat agent kernel (Stage 2B workspace package; naming is an open decision).",
  "type": "module",
  "license": "UNLICENSED",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./collab/*": {
      "types": "./dist/collab/*.d.ts",
      "import": "./dist/collab/*.js"
    },
    "./composition/*": {
      "types": "./dist/composition/*.d.ts",
      "import": "./dist/composition/*.js"
    },
    "./contracts/*": {
      "types": "./dist/contracts/*.d.ts",
      "import": "./dist/contracts/*.js"
    },
    "./instance/*": {
      "types": "./dist/instance/*.d.ts",
      "import": "./dist/instance/*.js"
    },
    "./loop/*": {
      "types": "./dist/loop/*.d.ts",
      "import": "./dist/loop/*.js"
    },
    "./memory/*": {
      "types": "./dist/memory/*.d.ts",
      "import": "./dist/memory/*.js"
    },
    "./resources/*": {
      "types": "./dist/resources/*.d.ts",
      "import": "./dist/resources/*.js"
    },
    "./runtime/*": {
      "types": "./dist/runtime/*.d.ts",
      "import": "./dist/runtime/*.js"
    },
    "./shared/*": {
      "types": "./dist/shared/*.d.ts",
      "import": "./dist/shared/*.js"
    },
    "./tape/*": {
      "types": "./dist/tape/*.d.ts",
      "import": "./dist/tape/*.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "node ../../scripts/build-agent-kernel.mjs"
  },
  "dependencies": {
    "jsonrepair": "^3.15.0",
    "nanoid": "^6.0.1",
    "tokenx": "2.1.0",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@types/node": "^24.13.3",
    "ollama": "^0.6.3"
  }
}
